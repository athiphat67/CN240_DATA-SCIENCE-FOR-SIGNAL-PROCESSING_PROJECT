# Src_V4 — XGBoost ML Signal Generator
# Copy this file to .env and fill in your values

# ─── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# ─── Discord Notification (required) ─────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_MENTION_ID=your_discord_user_id   # optional — @mention in alerts

# ─── Trade Log API (optional) ────────────────────────────────────────────────
TRADE_LOG_API_URL=
TRADE_LOG_API_KEY=

# ─── Runtime ─────────────────────────────────────────────────────────────────
DRY_RUN=true        # set to false for live trading
LOG_LEVEL=INFO
TIMEZONE=Asia/Bangkok

# ─── Execution Confirmation ───────────────────────────────────────────────────
REQUIRE_BUY_CONFIRM=true   # require manual confirm before BUY
AUTO_CONFIRM_SELL=true     # auto-confirm SELL signals

# ─── DB Table Names (override if needed) ─────────────────────────────────────
SIGNALS_TABLE=v3_signals
BAR_LOGS_TABLE=v3_bar_logs
SYSTEM_STATE_TABLE=v3_system_state
ACTIVE_TRADES_TABLE=v3_active_trades
